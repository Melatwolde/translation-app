# Supabase
SUPABASE_URL=[https://your-project.supabase.co](https://your-project.supabase.co)
SUPABASE_KEY=your-supabase-service-role-key

# Upstash Redis
UPSTASH_REDIS_URL=redis://default:token@your-host.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-token

# JWT Auth
JWT_SECRET=super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
ADDIS_AI_API_KEY=your-addis-ai-key
# ADDIS_API_KEY is also accepted for existing deployments.
ADDIS_AI_BASE_URL=https://your-addis-api-root
# Required for Chinese -> Amharic/Oromo after confirming Addis's TTS contract.
ADDIS_TTS_URL=
ALIBABA_DASHSCOPE_API_KEY=your-dashscope-api-key
# Optional model-specific WebSocket endpoint overrides; use complete valid hosts.
ALIBABA_SENSEVOICE_URL=
ALIBABA_COSYVOICE_URL=
# Optional. Defaults to the public Beijing DashScope WebSocket host.
ALIBABA_WS_BASE=wss://dashscope.aliyuncs.com/api-ws/v1
# Optional. Uses wss://<workspace>.cn-beijing.maas.aliyuncs.com/api-ws/v1 when set.
ALIBABA_WORKSPACE_ID=
ALIBABA_CHINESE_STT_MODEL=sensevoice-v1
ALIBABA_CHINESE_TTS_MODEL=qwen-audio-3.0-tts-flash
# Set this to the selected DashScope voice's raw PCM output rate if it cannot emit 16 kHz.
ALIBABA_CHINESE_TTS_SAMPLE_RATE=16000
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
TRANSLATION_PROVIDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=20
ADDIS_DEFAULT_VOICE_AM=am-hamen
ADDIS_DEFAULT_VOICE_OM=om-default

# LiveKit
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_ROOM_PREFIX=trans-
