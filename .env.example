# Supabase
SUPABASE_URL=[https://your-project.supabase.co](https://your-project.supabase.co)
SUPABASE_KEY=your-supabase-service-role-key

# Upstash Redis
UPSTASH_REDIS_URL=redis://default:token@your-host.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-token

# JWT Auth
JWT_SECRET=super-secret-jwt-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
ADDIS_API_KEY=your-addis-ai-key
GEMINI_API_KEY=your-gemini-api-key
ADDIS_DEFAULT_VOICE_AM=am-hamen
ADDIS_DEFAULT_VOICE_OM=om-default

# LiveKit
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_ROOM_PREFIX=trans-